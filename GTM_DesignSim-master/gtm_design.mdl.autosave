  state {
    id			    134
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    133
    treeNode		    [133 0 0 0]
    superState		    SUBCHART
    subviewer		    133
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function RollAngle = fcn(FlightState, UHeading, e)\n\nPHeadingAngle = 0.39;\n\nVa = FlightState.A"
      "irSpeed;\nHeadingAngle = FlightState.HeadingAngle;\nFlightPathAngle = FlightState.FlightPathAngle;\n\nYawAngle ="
      " HeadingAngle - asin((1/Va)*[e.WindNorth, e.WindEast]*[-sin(HeadingAngle); cos(HeadingAngle)]);\nb = [cos(Headin"
      "gAngle)*cos(FlightPathAngle), sin(HeadingAngle)*cos(FlightPathAngle), -sin(FlightPathAngle)]*[e.WindNorth; e.Win"
      "dEast; e.WindDown];\nc = [e.WindNorth, e.WindEast, e.WindDown]*[e.WindNorth; e.WindEast; e.WindDown]- Va^2;\nVg "
      "= -b+sqrt(b^2-c);\n\nRollAngle = atan2(PHeadingAngle*angdiff(HeadingAngle,UHeading)*Vg,e.Gravity*cos(HeadingAngl"
      "e-YawAngle));"
      vectorOutputs1D	      1
    }
  }
