  state {
    id			    101
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    100
    treeNode		    [100 0 0 0]
    superState		    SUBCHART
    subviewer		    100
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [T,TL,TR,H] = eng_angles(Tl,hl,Tr,hr,engl_ang,engr_ang)\n% This block supports an embedd"
      "able subset of the MATLAB language.\n% See the help menu for details. \n\n% Using the engine alignment angles (s"
      "et in AC_params_T2.m), compute the \n% off-axis thrust and angular momentum terms.\n\nTL = Tl*[cosd(engl_ang(2))"
      "*cosd(engl_ang(3));...\n         sind(engl_ang(3));...\n         -sind(engl_ang(2))*cosd(engl_ang(3))];\nTR = Tr"
      "*[cosd(engr_ang(2))*cosd(engr_ang(3));...\n         sind(engr_ang(3));...\n         -sind(engr_ang(2))*cosd(engr"
      "_ang(3))];  \nT = TL+TR;\n\nH = hl*[cosd(engl_ang(2))*cosd(engl_ang(3));...\n         sind(engl_ang(3));...\n   "
      "      -sind(engl_ang(2))*cosd(engl_ang(3))] + ...\n         hr*[cosd(engr_ang(2))*cosd(engr_ang(3));...\n       "
      "  sind(engr_ang(3));...\n         -sind(engr_ang(2))*cosd(engr_ang(3))];"
      editorLayout	      "100 M4x1[501 257 996 572]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', true)"
      fimathForFiConstructors FimathMatlabFactoryDefault
