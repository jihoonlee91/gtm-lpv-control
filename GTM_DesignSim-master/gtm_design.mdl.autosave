  chart {
    id			    40
    machine		    1
    name		    "GTM_T2/Aero/Dynamic Derviatives/Rotary Blended\n UnDamaged Case/Blending Function"
    windowPosition	    [454 463 213 385]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 1920 1080 1]
    treeNode		    [0 41 0 0]
    viewObj		    40
    ssIdHighWaterMark	    11
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    chartFileNumber	    5
    disableImplicitCasting  1
    eml {
      name		      "hykal"
    }
    supportVariableSizing   0
    firstData		    42
    firstTransition	    51
    firstJunction	    50
  }
  state {
    id			    41
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    40
    treeNode		    [40 0 0 0]
    superState		    SUBCHART
    subviewer		    40
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function[omega,pqr_osc]= hykal(alpha,beta,tas,pqr,B,Cbar)\n% Hybrid Kalviste blending method for "
      "use in embedded block in Simulink.\n%\n% Austin Murch\n% Austin.M.Murch@nasa.gov\n\n% Dimension vector outputs.\n"
      "pqr_osc=zeros(3,1);\n \n\n% Constants\ndtr=pi/180;\nknots2ft=1.689;\n\n% Setup variables\npb=pqr(1);\nqb=pqr(2);"
      "\nrb=pqr(3);\n\nalpha = alpha*dtr;\nbeta = beta*dtr;\nomega = 0;\n\n%----Hybrid Kalviste Method----%\nwhichcase "
      "= 0;\n\n%Test for case 1: p_osc = 0\nif cos(alpha)*cos(beta) == 0\nelseif pb == 0\nelse\n    omega = pb/(cos(alp"
      "ha)*cos(beta));\n    r_osc = rb - omega*sin(alpha)*cos(beta);\n    if abs(r_osc) > abs(rb)\n    elseif r_osc*rb "
      "< 0\n    else\n        whichcase = 1;\n    end\nend\n\n%Test for case 2: r_osc = 0\nif sin(alpha)*cos(beta) == 0"
      "\nelseif rb == 0\nelse\n    omega = rb/(sin(alpha)*cos(beta));\n    p_osc = pb - omega*cos(alpha)*cos(beta);\n  "
      "  if abs(p_osc) > abs(pb)\n    elseif p_osc*pb < 0\n    else\n        whichcase = 2;\n    end\nend\n\n%Test for "
      "case 3: Omega = 0\nif whichcase == 0\n    whichcase = 3;\nend\n\n \n\nswitch whichcase\n    case 1\n        omeg"
      "a = pb/(cos(alpha)*cos(beta));\n        pqr_osc(1) = 0;        \n        pqr_osc(2) = qb - omega*sin(beta);     "
      "   \n        pqr_osc(3) = rb - omega*sin(alpha)*cos(beta);\n\n    case 2\n        omega = rb/(sin(alpha)*cos(bet"
      "a));\n        pqr_osc(1) = pb - omega*cos(alpha)*cos(beta);\n        pqr_osc(2) = qb - omega*sin(beta);\n       "
      " pqr_osc(3) = 0;\n\n    case 3\n        pqr_osc(1) = pb;\n        pqr_osc(2) = qb;\n        pqr_osc(3) = rb;\n  "
      "      omega = 0;\nend\n\n%-----------------------------------------------% End Hybrid Kalviste\n\n% Scale values"
      " for table lookup\nb2vt=B/(2*tas*knots2ft);\nc2vt=Cbar/(2*tas*knots2ft);\nomega=omega*b2vt;\npqr_osc=pqr_osc.*[b"
      "2vt;c2vt;b2vt];\n\n "
      editorLayout	      "100 M4x1[305 535 671 364]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', true)"
      emlDefaultFimath	      FimathUserSpecified
      vectorOutputs1D	      1
    }
  }
