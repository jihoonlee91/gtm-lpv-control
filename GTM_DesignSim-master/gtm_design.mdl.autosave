    id			    61
    machine		    1
    name		    "GTM_T2/AuxiliaryVariables/Atmos76/atmos76"
    windowPosition	    [410 626 213 385]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 1920 1080 1]
    treeNode		    [0 62 0 0]
    viewObj		    61
