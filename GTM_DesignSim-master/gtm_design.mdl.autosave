		  RequestExecContextInheritance	off
		  Object {
		    $PropName		    "MaskObject"
		    $ObjectID		    427
		    $ClassName		    "Simulink.Mask"
		    Description		    "Implements Damage Models as gain and bias effects on selected surfaces."
		    Initialization	    "\nSurfList={...\n    'RUDU','RUDL',...\n    'AILL','AILR',...\n    'SPLLIB','SPLRIB','SPLLOB"
		    "','SPLROB',...\n    'STAB',...\n    'ELLOB','ELLIB','ELRIB','ELROB',...\n    'FLAPLOB','FALPLIB','FLAPRIB','FLAP"
		    "ROB',...\n    'GEAR'\n    };\n\nNcases=length(DamageModels);\nNsurfs=length(SurfList);\nSurfGain=ones(Ncases,Nsu"
		    "rfs,6);   %Nominally unity gain, zero bias\n\n%If damage case includes gain/bias on a surface adjust nominal val"
		    "ues\n% First damage case is \"no damage\".\nfor i=1:Ncases,\n for j=1:Nsurfs,\n    if isfield(DamageModels{i},Su"
		    "rfList{j}),\n        SurfGain(i,j,:)=DamageModels{i}.(SurfList{j}).gain*ones(1,6);\n    end\n end\nend\n\n      "
		    "  \n        "
		    Object {
		    $PropName		    "Parameters"
		    $ObjectID		    428
		    $ClassName		    "Simulink.MaskParameter"
		    Type		    "edit"
		    Name		    "DamageModels"
		    Prompt		    "Cell Array of Damage Models"
		    Value		    "DamageModels"
		    }
