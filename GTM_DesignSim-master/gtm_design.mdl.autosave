    eml {
      isEML		      1
      script		      "function [I,InvI] = Inertia(Ixx,Iyy,Izz,Ixz,Iyz,Ixy)\n% This block supports an embeddable subset "
      "of the MATLAB language.\n% See the help menu for details. \n\nI=[ Ixx, -Ixy, -Ixz;\n   -Ixy,  Iyy, -Iyz;\n   -Ix"
      "z, -Iyz,   Izz ];\n\ndet = Ixx*Iyy*Izz-Ixx*Iyz^2-Ixy^2*Izz-2*Ixy*Ixz*Iyz-Ixz^2*Iyy;\n\nadjoint=[...\nIyy*Izz-Iyz"
      "^2,    Ixy*Izz+Ixz*Iyz, Ixy*Iyz+Ixz*Iyy;...\nIxy*Izz+Ixz*Iyz,   Ixx*Izz-Ixz^2,  Ixx*Iyz+Ixy*Ixz;...\nIxy*Iyz+Ixz"
      "*Iyy,  Ixx*Iyz+Ixy*Ixz,   Ixx*Iyy-Ixy^2     ];\n\nInvI=adjoint/det;\n"
      editorLayout	      "100 M4x1[146 214 709 544]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', true)"
      emlDefaultFimath	      FimathUserSpecified
      vectorOutputs1D	      1
