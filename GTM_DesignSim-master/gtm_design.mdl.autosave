		Annotation {
		  SID			  "2573"
		  Name			  "The basic aerodynamics are asymmetric.\nWhen the 'symmetry_on' flag is set, increments \nfrom the dC3_sy"
		  "m aero table are added to the \nlateral-directional coefficients (CY,Cl,Cn) to make \nthem symmetric.  When the fl"
		  "ag is off, the gain of \n2.0 is applied to the increments,which effectively \nchanges the sign of the asymmetries."
		  "  "
		  Position		  [608, 245, 829, 331]
		  InternalMargins	  [0, 0, 0, 0]
		  ZOrder		  -1
		}
