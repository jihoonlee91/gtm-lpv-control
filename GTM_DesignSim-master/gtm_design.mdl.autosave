      script		      "function dC6 = fcn(SurfVec,DamageCase,SurfGain)\n% This block supports an embeddable subset of th"
      "e MATLAB language.\n% See the help menu for details. \ndamagecase = cast(round(DamageCase),'uint32');\nNsurfs=18"
      ";\nif (damagecase==0),\n    dC6=ones(1,Nsurfs)*(reshape(SurfVec,6,Nsurfs)');\nelse\n  gain=squeeze(SurfGain(dama"
      "gecase,:,:));\n  dC6=ones(1,Nsurfs)*( transpose(reshape(SurfVec,6,Nsurfs)).*gain);\nend\n\n\n\n"
      editorLayout	      "100 M4x1[45 45 1080 712]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', true)"
      emlDefaultFimath	      FimathUserSpecified
      vectorOutputs1D	      1
    }
  }
