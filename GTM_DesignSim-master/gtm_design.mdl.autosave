      name		      "layer1atm"
    }
    supportVariableSizing   0
    firstData		    63
    firstTransition	    67
    firstJunction	    66
  }
  state {
    id			    62
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    61
    treeNode		    [61 0 0 0]
    superState		    SUBCHART
    subviewer		    61
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function y = layer1atm(z,dt)\n% Author: Kevin Cunningham          April 20, 1992    \n% Modified:"
      " Dave Cox                Aug, 14, 2008\n\ny=zeros(6,1);\n\n%dt=0;  % Standard Temp forced.\n\n%    --- constants"
      " from 1976 std. atmosphere\nr     = 1716.55915670803;\ngamma = 1.4;\ng     = 32.17405;\nre    = 20855531.5;\ntsl"
      "   = 288.15 * 1.8;\npsl   = 2116.22;\nhsl   = 0.;\nsldens = 0.0023769;                 % atmospheric density at "
      "sea level\nslpr   = 2116.220;                  % sea level pressure, psf\n\n%-----------------------------------"
      "----------------------------------\n%    conversion from metric lapse rate to english lapse rate\n%    meters/0."
      "3048 = ft\n%    Kelvin * 1.8 = Rankine\nrm2ft = 1000.0/0.3048;\nconlapse = 1.8/rm2ft;\n\n%  ---- convert geometr"
      "ic alt. to geopotential alt.\nh     = (re*z)/(re+z);\n \n%  ---- ensure we are in layer one (based on geopotenti"
      "al alt)\nif (h > 11*rm2ft) % 11 km\n  %fprintf(1,'Error, atmosphere model out of range %f, Limiting...\\n',h);\n"
      "  h=11*rm2ft;\nend\nif (h<0)\n  %fprintf(1,'Error, atmosphere model out of range %f, Limiting...\\n',h);\n  h=0;"
      "\nend\n\na1     = -6.5*conlapse;\nt1     = tsl + a1*(h-hsl);\ndel1   = (t1/tsl)^(-g/r/a1);\np1     = del1 * psl;"
      "\n\n%   ---- apply temperature increment from standard day*/\nt1     = t1 + dt;\n\n%   ---- calculate density fr"
      "om eqn. of state w/ corrected temp.*/\nrho1   = p1 / (r * t1);\n \n%   ---- calculate speed of sound w/ correcte"
      "d temp.*/\nc1     = sqrt(gamma * (r * t1));\n \n\n% Calculate outputs\ny(1) = rho1;\ny(2) = p1;\ny(3) = t1 / 1.8"
      "; % output temperature  in Kelvin\ny(4) = c1;\ny(5) = y(2) / slpr;         % pressure ratio\ny(6) = sqrt(y(1)/sl"
      "dens);   % SQUARE ROOT OF DENSITY RATIO\n\n"
      editorLayout	      "100 M4x1[45 45 720 640]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', true)"
      emlDefaultFimath	      FimathUserSpecified
      vectorOutputs1D	      1
    }
  }
