		    BlockType		    SubSystem
		    Name		    "RollYaw Coupling\nLIB"
		    SID			    "743"
		    Ports		    [1, 1]
		    Position		    [445, 500, 485, 520]
		    ZOrder		    -61
		    BackgroundColor	    "cyan"
		    RequestExecContextInheritance off
		    Object {
		    $PropName		    "MaskObject"
		    $ObjectID		    508
		    $ClassName		    "Simulink.Mask"
		    Description		    "Approximates roll/yaw coupling of split longitudinal surface \ndeflections (spoilers, elevator"
		    "s, flaps) where the base aero data only\nhas CX, CZ, and Cm. Input should be a 6 element vector of the aero\ncoe"
		    "fficients [CZ CY CZ Cl Cm Cn].\n\nCl = Cl_input + arm*CZ_input\nCn = Cn_input + arm*CX_input"
		    Initialization	    "Kc = eye(6);\n\nKc(4,3) = arm; % Cl = Cl + arm*CZ\nKc(6,1) = -arm; % Cn = Cn - arm*CX"
		    Object {
		    $PropName		    "Parameters"
		    $ObjectID		    509
		    $ClassName		    "Simulink.MaskParameter"
		    Type		    "edit"
		    Name		    "arm"
		    Prompt		    "Moment arm (nd)"
		    Value		    "-0.03"
		    }
		    }
