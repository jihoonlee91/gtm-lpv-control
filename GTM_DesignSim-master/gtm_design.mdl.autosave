    Block {
      BlockType		      SubSystem
      Name		      "NamedStore"
      SID		      "53"
      Ports		      [1]
      Position		      [825, 421, 875, 449]
      ZOrder		      1165
      BackgroundColor	      "cyan"
      StopFcn		      "% if strmatch(get_param(gcb,'do_stopfcn_callback'),...\n% 'on','exact')                         "
      "              \n%    if exist('logsout','var')                        \n%        sout = CreateSimOut(logsout);  "
      "              \n%    else                                             \n%         %disp('No Log Data Variable') "
      "              \n%     end                                             \n% clear logsout                         "
      "              \n% end                                                 "
      FontName		      "helvetica"
      FontSize		      12
      RequestExecContextInheritance off
      Object {
	$PropName		"MaskObject"
	$ObjectID		671
	$ClassName		"Simulink.Mask"
	Description		"Produces signal log of input data.  If post processing is selected the logsout object is converted into"
	" a data structure (sout) with fields named after the bus signals.  In this case a common time base is recommended."
	Initialization		"H=get_param([gcb,'/In'],'PortHandles');\nif (enable_logging)\n    set(H.Outport(1),'DataLogging','on"
	"')\nelse\n    set(H.Outport(1),'DataLogging','off')\n    \nend\n"
	Array {
	  Type			  "Simulink.MaskParameter"
	  Dimension		  2
	  Object {
	    $ObjectID		    672
	    Type		    "checkbox"
	    Name		    "enable_logging"
	    Prompt		    "Enable Data Logging"
	    Value		    "on"
	  }
	  Object {
	    $ObjectID		    673
	    Type		    "checkbox"
	    Name		    "do_stopfcn_callback"
	    Prompt		    "Post-process logsout"
	    Value		    "on"
	  }
	  PropName		  "Parameters"
	}
      }
