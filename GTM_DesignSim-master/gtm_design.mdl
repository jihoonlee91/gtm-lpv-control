<?xml version="1.0" encoding="utf-8"?>
<chart id="74">
  <P Name="name">GTM_T2/AuxiliaryVariables/Atmos76/atmos76</P>
  <P Name="windowPosition">[410 626 213 385]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 1920 1080 1]</P>
  <P Name="viewObj">74</P>
  <P Name="ssIdHighWaterMark">6</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">7</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">layer1atm</P>
  </eml>
  <P Name="supportVariableSizing">0</P>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">74</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function y = layer1atm(z,dt)
% Author: Kevin Cunningham          April 20, 1992    
% Modified: Dave Cox                Aug, 14, 2008

y=zeros(6,1);

%dt=0;  % Standard Temp forced.

%    --- constants from 1976 std. atmosphere
r     = 1716.55915670803;
gamma = 1.4;
g     = 32.17405;
re    = 20855531.5;
tsl   = 288.15 * 1.8;
psl   = 2116.22;
hsl   = 0.;
sldens = 0.0023769;                 % atmospheric density at sea level
slpr   = 2116.220;                  % sea level pressure, psf

%---------------------------------------------------------------------
%    conversion from metric lapse rate to english lapse rate
%    meters/0.3048 = ft
%    Kelvin * 1.8 = Rankine
rm2ft = 1000.0/0.3048;
conlapse = 1.8/rm2ft;

%  ---- convert geometric alt. to geopotential alt.
h     = (re*z)/(re+z);
 
%  ---- ensure we are in layer one (based on geopotential alt)
if (h &gt; 11*rm2ft) % 11 km
  %fprintf(1,&apos;Error, atmosphere model out of range %f, Limiting...\n&apos;,h);
  h=11*rm2ft;
end
if (h&lt;0)
  %fprintf(1,&apos;Error, atmosphere model out of range %f, Limiting...\n&apos;,h);
  h=0;
end

a1     = -6.5*conlapse;
t1     = tsl + a1*(h-hsl);
del1   = (t1/tsl)^(-g/r/a1);
p1     = del1 * psl;

%   ---- apply temperature increment from standard day*/
t1     = t1 + dt;

%   ---- calculate density from eqn. of state w/ corrected temp.*/
rho1   = p1 / (r * t1);
 
%   ---- calculate speed of sound w/ corrected temp.*/
c1     = sqrt(gamma * (r * t1));
 

% Calculate outputs
y(1) = rho1;
y(2) = p1;
y(3) = t1 / 1.8; % output temperature  in Kelvin
y(4) = c1;
y(5) = y(2) / slpr;         % pressure ratio
y(6) = sqrt(y(1)/sldens);   % SQUARE ROOT OF DENSITY RATIO

</P>
        <P Name="fimathString">fimath(...
&apos;RoundMode&apos;, &apos;floor&apos;,...
&apos;OverflowMode&apos;, &apos;wrap&apos;,...
&apos;ProductMode&apos;, &apos;KeepLSB&apos;, &apos;ProductWordLength&apos;, 32,...
&apos;SumMode&apos;, &apos;KeepLSB&apos;, &apos;SumWordLength&apos;, 32,...
&apos;CastBeforeSum&apos;, true)</P>
        <P Name="emlDefaultFimath">FimathUserSpecified</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
    <data SSID="4" name="z">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="y">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="dt">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <transition SSID="2">
      <P Name="labelString">{eML_blk_kernel();}</P>
      <P Name="labelPosition">[32.125 19.875 102.544 14.964]</P>
      <P Name="fontSize">12</P>
      <src>
        <P Name="intersection">[0 0 1 0 23.5747 14.625 0 0]</P>
      </src>
      <dst>
        <P Name="SSID">3</P>
        <P Name="intersection">[1 0 -1 0 23.5747 42.5747 0 0]</P>
      </dst>
      <P Name="midPoint">[23.5747 24.9468]</P>
      <P Name="dataLimits">[21.175 25.975 14.625 42.575]</P>
      <P Name="subviewer">74</P>
      <P Name="drawStyle">SMART</P>
      <slide>
        <P Name="sticky">BOTH_STICK</P>
      </slide>
      <P Name="executionOrder">1</P>
    </transition>
    <junction SSID="3">
      <P Name="position">[23.5747 49.5747 7]</P>
      <P Name="subviewer">74</P>
      <P Name="type">CONNECTIVE_JUNCTION</P>
    </junction>
  </Children>
</chart>

