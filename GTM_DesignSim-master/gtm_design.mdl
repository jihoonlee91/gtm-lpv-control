__MWOPC_PART_BEGIN__ /simulink/bddefaults.xml
<?xml version="1.0" encoding="utf-8"?>
<BlockDiagramDefaults>
  <SystemDefaults>
    <P Name="ModelBrowserWidth">212</P>
  </SystemDefaults>
  <BlockDefaults>
    <P Name="FontName">Bitstream Vera Sans</P>
  </BlockDefaults>
  <AnnotationDefaults>
    <P Name="HorizontalAlignment">center</P>
    <P Name="VerticalAlignment">middle</P>
    <P Name="FontName">Arial</P>
  </AnnotationDefaults>
  <LineDefaults>
    <P Name="FontName">Bitstream Vera Sans</P>
    <P Name="FontSize">10</P>
  </LineDefaults>
  <MaskDefaults SelfModifiable="off">
    <Display IconFrame="on" IconOpaque="opaque" RunInitForIconRedraw="analyze" IconRotate="none" PortRotate="default" IconUnits="autoscale"/>
    <MaskParameter Evaluate="on" Tunable="on" NeverSave="off" Internal="off" ReadOnly="off" Enabled="on" Visible="on" ToolTip="on"/>
    <DialogControl>
      <ControlOptions Visible="on" Enabled="on" Row="new" HorizontalStretch="on" PromptLocation="top" Orientation="horizontal" Scale="linear" TextType="Plain Text" Expand="off" ShowFilter="on" ShowParameterName="on" WordWrap="on" AlignPrompts="off"/>
    </DialogControl>
  </MaskDefaults>
  <BlockParameterDefaults>
    <Block BlockType="Abs">
      <P Name="ZeroCross">on</P>
      <P Name="SampleTime">-1</P>
      <P Name="OutMin">[]</P>
      <P Name="OutMax">[]</P>
      <P Name="OutDataTypeStr">Inherit: Same as input</P>
      <P Name="LockScale">off</P>
      <P Name="RndMeth">Floor</P>
      <P Name="SaturateOnIntegerOverflow">on</P>
    </Block>
    <Block BlockType="ActionPort">
      <P Name="InitializeStates">held</P>
      <P Name="PropagateVarSize">Only when execution is resumed</P>
      <P Name="DisallowConstTsAndPrmTs">off</P>
      <P Name="ActionPortLabel">Action</P>
    </Block>
    <Block BlockType="Assertion">
      <P Name="Enabled">on</P>
      <P Name="StopWhenAssertionFail">on</P>
      <P Name="SampleTime">-1</P>
    </Block>
    <Block BlockType="Assignment">
      <P Name="NumberOfDimensions">1</P>
      <P Name="IndexMode">One-based</P>
      <P Name="OutputInitialize">Initialize using input port &lt;Y0&gt;</P>
      <P Name="DiagnosticForDimensions">None</P>
      <P Name="SampleTime">-1</P>
    </Block>
    <Block BlockType="BusAssignment"/>
    <Block BlockType="BusCreator">
      <P Name="DisplayOption">none</P>
      <P Name="OutDataTypeStr">Inherit: auto</P>
      <P Name="NonVirtualBus">off</P>
    </Block>
    <Block BlockType="BusSelector">
      <P Name="OutputAsBus">off</P>
    </Block>
    <Block BlockType="BusToVector"/>
    <Block BlockType="Clock">
      <P Name="DisplayTime">off</P>
      <P Name="Decimation">10</P>
    </Block>
    <Block BlockType="Concatenate">
      <P Name="NumInputs">2</P>
      <P Name="Mode">Vector</P>
      <P Name="ConcatenateDimension">1</P>
    </Block>
    <Block BlockType="Constant">
      <P Name="Value">1</P>
      <P Name="VectorParams1D">on</P>
      <P Name="SamplingMode">Sample based</P>
      <P Name="OutMin">[]</P>
      <P Name="OutMax">[]</P>
      <P Name="OutDataTypeStr">Inherit: Inherit from &apos;Constant value&apos;</P>
      <P Name="LockScale">off</P>
      <P Name="SampleTime">inf</P>
      <P Name="FramePeriod">inf</P>
      <P Name="PreserveConstantTs">off</P>
    </Block>
    <Block BlockType="DataTypeConversion">
      <P Name="OutMin">[]</P>
      <P Name="OutMax">[]</P>
      <P Name="OutDataTypeStr">Inherit: Inherit via back propagation</P>
      <P Name="LockScale">off</P>
      <P Name="ConvertRealWorld">Real World Value (RWV)</P>
      <P Name="RndMeth">Zero</P>
      <P Name="SaturateOnIntegerOverflow">on</P>
      <P Name="SampleTime">-1</P>
    </Block>
    <Block BlockType="DeadZone">
      <P Name="LowerValue">-0.5</P>
      <P Name="UpperValue">0.5</P>
      <P Name="SaturateOnIntegerOverflow">on</P>
      <P Name="LinearizeAsGain">on</P>
      <P Name="ZeroCross">on</P>
      <P Name="SampleTime">-1</P>
    </Block>
    <Block BlockType="Demux">
      <P Name="Outputs">4</P>
      <P Name="DisplayOption">bar</P>
      <P Name="BusSelectionMode">off</P>
    </Block>
    <Block BlockType="DotProduct">
      <P Name="InputSameDT">on</P>
      <P Name="OutMin">[]</P>
      <P Name="OutMax">[]</P>
      <P Name="OutDataTypeStr">Inherit: Same as first input</P>
      <P Name="LockScale">off</P>
      <P Name="RndMeth">Floor</P>
      <P Name="SaturateOnIntegerOverflow">off</P>
      <P Name="SampleTime">-1</P>
    </Block>
    <Block BlockType="EnablePort">
      <P Name="StatesWhenEnabling">held</P>
      <P Name="PropagateVarSize">Only when enabling</P>
      <P Name="ShowOutputPort">off</P>
      <P Name="ZeroCross">on</P>
      <P Name="DisallowConstTsAndPrmTs">off</P>
      <P Name="PortDimensions">1</P>
      <P Name="SampleTime">-1</P>
      <P Name="OutMin">[]</P>
      <P Name="OutMax">[]</P>
      <P Name="OutDataTypeStr">double</P>
      <P Name="Interpolate">on</P>
    </Block>
    <Block BlockType="Fcn">
      <P Name="Expr">sin(u[1])</P>
      <P Name="SampleTime">-1</P>
    </Block>
    <Block BlockType="From">
      <P Name="GotoTag">A</P>
      <P Name="IconDisplay">Tag</P>
      <P Name="TagVisibility">local</P>
    </Block>
    <Block BlockType="Gain">
      <P Name="Gain">1</P>
      <P Name="Multiplication">Element-wise(K.*u)</P>
      <P Name="ParamMin">[]</P>
      <P Name="ParamMax">[]</P>
      <P Name="ParamDataTypeStr">Inherit: Inherit via internal rule</P>
      <P Name="OutMin">[]</P>
      <P Name="OutMax">[]</P>
      <P Name="OutDataTypeStr">Inherit: Inherit via internal rule</P>
      <P Name="LockScale">off</P>
      <P Name="RndMeth">Floor</P>
      <P Name="SaturateOnIntegerOverflow">off</P>
      <P Name="SampleTime">-1</P>
    </Block>
    <Block BlockType="Goto">
      <P Name="GotoTag">A</P>
      <P Name="IconDisplay">Tag</P>
      <P Name="TagVisibility">local</P>
    </Block>
    <Block BlockType="Ground"/>
    <Block BlockType="Inport">
      <P Name="Port">1</P>
      <P Name="AllowServiceAccess">off</P>
      <P Name="IconDisplay">Port number</P>
      <P Name="OutputFunctionCall">off</P>
      <P Name="OutMin">[]</P>
      <P Name="OutMax">[]</P>
      <P Name="OutDataTypeStr">Inherit: auto</P>
      <P Name="LockScale">off</P>
      <P Name="BusOutputAsStruct">off</P>
      <P Name="Unit">inherit</P>
      <P Name="PortDimensions">-1</P>
      <P Name="VarSizeSig">Inherit</P>
      <P Name="SampleTime">-1</P>
      <P Name="SignalType">auto</P>
      <P Name="SamplingMode">auto</P>
      <P Name="LatchByDelayingOutsideSignal">off</P>
      <P Name="LatchInputForFeedbackSignals">off</P>
      <P Name="Interpolate">on</P>
    </Block>
    <Block BlockType="InportShadow">
      <P Name="Port">1</P>
      <P Name="AllowServiceAccess">off</P>
      <P Name="IconDisplay">Port number</P>
      <P Name="OutputFunctionCall">off</P>
      <P Name="OutMin">[]</P>
      <P Name="OutMax">[]</P>
      <P Name="OutDataTypeStr">Inherit: auto</P>
      <P Name="LockScale">off</P>
      <P Name="BusOutputAsStruct">off</P>
      <P Name="Unit">inherit</P>
      <P Name="PortDimensions">-1</P>
      <P Name="VarSizeSig">Inherit</P>
      <P Name="SampleTime">-1</P>
      <P Name="SignalType">auto</P>
      <P Name="SamplingMode">auto</P>
      <P Name="LatchByDelayingOutsideSignal">off</P>
      <P Name="LatchInputForFeedbackSignals">off</P>
      <P Name="Interpolate">on</P>
    </Block>
    <Block BlockType="Integrator">
      <P Name="ExternalReset">none</P>
      <P Name="InitialConditionSource">internal</P>
      <P Name="InitialCondition">0</P>
      <P Name="LimitOutput">off</P>
      <P Name="UpperSaturationLimit">inf</P>
      <P Name="LowerSaturationLimit">-inf</P>
      <P Name="WrapState">off</P>
      <P Name="WrappedStateUpperValue">pi</P>
      <P Name="WrappedStateLowerValue">-pi</P>
      <P Name="ShowSaturationPort">off</P>
      <P Name="ShowStatePort">off</P>
      <P Name="AbsoluteTolerance">auto</P>
      <P Name="IgnoreLimit">off</P>
      <P Name="ZeroCross">on</P>
      <P Name="ContinuousStateAttributes">&apos;&apos;</P>
    </Block>
    <Block BlockType="Interpolation_n-D">
      <P Name="NumberOfTableDimensions">2</P>
      <P Name="TableSource">Dialog</P>
      <P Name="Table">sqrt([1:11]&apos; * [1:11])</P>
      <P Name="TableSpecification">Explicit values</P>
      <P Name="InterpMethod">Linear point-slope</P>
      <P Name="ExtrapMethod">Linear</P>
      <P Name="DiagnosticForOutOfRangeInput">None</P>
      <P Name="RequireIndexFractionAsBus">off</P>
      <P Name="RemoveProtectionIndex">off</P>
      <P Name="ValidIndexMayReachLast">off</P>
      <P Name="NumSelectionDims">0</P>
      <P Name="SampleTime">-1</P>
      <P Name="OutMin">[]</P>
      <P Name="OutMax">[]</P>
      <P Name="OutDataTypeStr">Inherit: Inherit from &apos;Table data&apos;</P>
      <P Name="InternalRulePriority">Precision</P>
      <P Name="LockScale">off</P>
      <P Name="RndMeth">Floor</P>
      <P Name="SaturateOnIntegerOverflow">off</P>
      <P Name="TableMin">[]</P>
      <P Name="TableMax">[]</P>
      <P Name="TableDataTypeStr">Inherit: Same as output</P>
      <P Name="IntermediateResultsDataTypeStr">Inherit: Same as output</P>
      <P Name="LUTDesignTableMode">Redesign Table</P>
      <P Name="LUTDesignDataSource">Block Dialog</P>
      <P Name="LUTDesignFunctionName">sqrt(x)</P>
      <P Name="LUTDesignUseExistingBP">on</P>
      <P Name="LUTDesignRelError">0.01</P>
      <P Name="LUTDesignAbsError">1e-6</P>
    </Block>
    <Block BlockType="Logic">
      <P Name="Operator">AND</P>
      <P Name="Inputs">2</P>
      <P Name="IconShape">rectangular</P>
      <P Name="AllPortsSameDT">on</P>
      <P Name="OutDataTypeStr">Inherit: Logical (see Configuration Parameters: Optimization)</P>
      <P Name="SampleTime">-1</P>
    </Block>
    <Block BlockType="Lookup">
      <P Name="InputValues">[-4:5]</P>
      <P Name="Table"> rand(1,10)-0.5</P>
      <P Name="LookUpMeth">Interpolation-Extrapolation</P>
      <P Name="OutMin">[]</P>
      <P Name="OutMax">[]</P>
      <P Name="OutDataTypeStr">Inherit: Same as input</P>
      <P Name="LockScale">off</P>
      <P Name="RndMeth">Floor</P>
      <P Name="SaturateOnIntegerOverflow">on</P>
      <P Name="SampleTime">-1</P>
      <P Name="LUTDesignTableMode">Redesign Table</P>
      <P Name="LUTDesignDataSource">Block Dialog</P>
      <P Name="LUTDesignFunctionName">sqrt(x)</P>
      <P Name="LUTDesignUseExistingBP">on</P>
      <P Name="LUTDesignRelError">0.01</P>
      <P Name="LUTDesignAbsError">1e-6</P>
    </Block>
    <Block BlockType="ManualSwitch">
      <P Name="CurrentSetting">1</P>
      <P Name="varsize">off</P>
      <P Name="SampleTime">-1</P>
    </Block>
    <Block BlockType="Math">
      <P Name="Operator">exp</P>
      <P Name="AlgorithmMethod">Exact</P>
      <P Name="SignedPower">off</P>
      <P Name="OutputSignalType">auto</P>
      <P Name="SampleTime">-1</P>
      <P Name="OutMin">[]</P>
      <P Name="OutMax">[]</P>
      <P Name="OutDataTypeStr">Inherit: Same as first input</P>
      <P Name="LockScale">off</P>
      <P Name="RndMeth">Floor</P>
      <P Name="SaturateOnIntegerOverflow">on</P>
      <P Name="IntermediateResultsDataTypeStr">Inherit: Inherit via internal rule</P>
      <P Name="AlgorithmType">Newton-Raphson</P>
      <P Name="Iterations">3</P>
    </Block>
    <Block BlockType="Merge">
      <P Name="Inputs">2</P>
      <P Name="InitialOutput">[]</P>
      <P Name="AllowUnequalInputPortWidths">off</P>
      <P Name="InputPortOffsets">[]</P>
    </Block>
    <Block BlockType="Mux">
      <P Name="Inputs">4</P>
      <P Name="DisplayOption">none</P>
      <P Name="UseBusObject">off</P>
      <P Name="BusObject">BusObject</P>
      <P Name="NonVirtualBus">off</P>
    </Block>
    <Block BlockType="Outport">
      <P Name="Port">1</P>
      <P Name="AllowServiceAccess">off</P>
      <P Name="IconDisplay">Port number</P>
      <P Name="OutputFunctionCall">off</P>
      <P Name="OutMin">[]</P>
      <P Name="OutMax">[]</P>
      <P Name="OutDataTypeStr">Inherit: auto</P>
      <P Name="LockScale">off</P>
      <P Name="BusOutputAsStruct">off</P>
      <P Name="Unit">inherit</P>
      <P Name="PortDimensions">-1</P>
      <P Name="VarSizeSig">Inherit</P>
      <P Name="SampleTime">-1</P>
      <P Name="SignalType">auto</P>
      <P Name="SamplingMode">auto</P>
      <P Name="EnsureOutportIsVirtual">off</P>
      <P Name="SourceOfInitialOutputValue">Dialog</P>
      <P Name="OutputWhenDisabled">held</P>
      <P Name="InitialOutput">[]</P>
      <P Name="MustResolveToSignalObject">off</P>
      <P Name="OutputWhenUnConnected">off</P>
      <P Name="OutputWhenUnconnectedValue">0</P>
      <P Name="VectorParamsAs1DForOutWhenUnconnected">on</P>
    </Block>
    <Block BlockType="Polyval">
      <P Name="Coefs">[1,2]</P>
    </Block>
    <Block BlockType="PreLookup">
      <P Name="BreakpointsDataSource">Dialog</P>
      <P Name="BreakpointsData">[10:10:100]</P>
      <P Name="BreakpointsSpecification">Explicit values</P>
      <P Name="BreakpointsNumPoints">11</P>
      <P Name="BreakpointsFirstPoint">10</P>
      <P Name="BreakpointsSpacing">10</P>
      <P Name="OutputSelection">Index and fraction</P>
      <P Name="IndexSearchMethod">Binary search</P>
      <P Name="BeginIndexSearchUsingPreviousIndexResult">off</P>
      <P Name="ExtrapMethod">Clip</P>
      <P Name="UseLastBreakpoint">off</P>
      <P Name="RemoveProtectionInput">off</P>
      <P Name="DiagnosticForOutOfRangeInput">None</P>
      <P Name="BreakpointMin">[]</P>
      <P Name="BreakpointMax">[]</P>
      <P Name="BreakpointDataTypeStr">Inherit: Same as input</P>
      <P Name="IndexDataTypeStr">uint32</P>
      <P Name="FractionDataTypeStr">Inherit: Inherit via internal rule</P>
