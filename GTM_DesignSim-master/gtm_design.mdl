    <P Name="ZOrder">-12</P>
    <P Name="RequestExecContextInheritance">off</P>
    <Mask>
      <Display/>
      <Initialization>Ncases=length(DamageModels);
dCGDamage=zeros(Ncases+1,3);   
dMassDamage=zeros(Ncases+1,1);
dInertiaDamage=zeros(Ncases+1,6);
for i=1:Ncases,
  if isfield(DamageModels{i},&apos;Mass&apos;),
     dInertiaDamage(i+1,:)=DamageModels{i}.Mass.dIxxIyyIzzIxzIyzIxy;
     dCGDamage(i+1,:)=DamageModels{i}.Mass.dCG;
     dMassDamage(i+1)=DamageModels{i}.Mass.dWeight;
  end
end
</Initialization>
      <MaskParameter Name="DamageModels" Type="edit">
        <Prompt>Array of Damage Cases</Prompt>
        <Value>DamageModels</Value>
      </MaskParameter>
    </Mask>
