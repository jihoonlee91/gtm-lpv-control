  <Block BlockType="SubSystem" Name="Heading Control" SID="6307">
    <P Name="Ports">[3, 1]</P>
    <P Name="Position">[-495, 50, -315, 150]</P>
    <P Name="ZOrder">1247</P>
    <P Name="Commented">on</P>
    <P Name="ErrorFcn">Stateflow.Translate.translate</P>
    <P Name="PermitHierarchicalResolution">ExplicitOnly</P>
    <P Name="TreatAsAtomicUnit">on</P>
    <P Name="RequestExecContextInheritance">off</P>
    <P Name="SFBlockType">MATLAB Function</P>
    <P Name="ContentPreviewEnabled">on</P>
    <Mask>
      <Type>Fixed Wing Heading Controller</Type>
      <Display RunInitForIconRedraw="off">color(&apos;white&apos;);

plot([100,100,100,100],[100,100,100,100]);

plot([0,0,0,0],[0,0,0,0]);

color(&apos;black&apos;)
text(52, 50, &apos;Heading\n Control&apos;, &apos;horizontalAlignment&apos;, &apos;center&apos;);
port_label(&apos;input&apos;, 1, &apos;State&apos;)
port_label(&apos;input&apos;, 2, &apos;TargetHeading&apos;)
port_label(&apos;input&apos;, 3, &apos;Environment&apos;)
port_label(&apos;output&apos;, 1, &apos;TargetRoll&apos;)
</Display>
      <Description>P controller that regulates fixed wing UAV heading direction through controlling its roll angle. This controller requires that the plane is flying under coordinated flight condition.</Description>
      <MaskParameter Name="PHeadingAngle" Type="edit">
        <Prompt>Heading Control Gain</Prompt>
        <Value>3.9</Value>
      </MaskParameter>
      <DialogControl Type="Group" Name="DescGroupVar">
        <Prompt>%&lt;MaskType&gt;</Prompt>
        <DialogControl Type="Text" Name="DescTextVar">
          <Prompt>%&lt;MaskDescription&gt;</Prompt>
        </DialogControl>
      </DialogControl>
      <DialogControl Type="Group" Name="ParameterGroupVar">
        <Prompt>Simulink:studio:ToolBarParametersMenu</Prompt>
        <DialogControl Type="Edit" Name="PHeadingAngle">
          <Prompt>Heading Control Gain</Prompt>
          <ControlOptions PromptLocation="left"/>
        </DialogControl>
      </DialogControl>
    </Mask>
    <Port>
      <P Name="PortNumber">1</P>
      <P Name="Name">phi_c</P>
    </Port>
    <System Ref="system_6307"/>
  </Block>
