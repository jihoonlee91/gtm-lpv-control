      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function y = fcn(u,p)
% This block supports the Embedded MATLAB subset.
% See the help menu for details. 


y = sum(p.*u.^(length(p)-1:-1:0));

</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[146.0, 214.0, 671.0, 364.0]</P>
