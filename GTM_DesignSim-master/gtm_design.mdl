<?xml version="1.0" encoding="utf-8"?>
<chart id="113">
  <P Name="name">GTM_T2/Engines/Engine Alignment</P>
  <P Name="windowPosition">[641 673 213 385]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 1920 1080 1]</P>
  <P Name="viewObj">113</P>
  <P Name="ssIdHighWaterMark">13</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">11</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">eng_angles</P>
  </eml>
  <P Name="supportVariableSizing">0</P>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">113</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [T,TL,TR,H] = eng_angles(Tl,hl,Tr,hr,engl_ang,engr_ang)
% This block supports an embeddable subset of the MATLAB language.
% See the help menu for details. 

% Using the engine alignment angles (set in AC_params_T2.m), compute the 
% off-axis thrust and angular momentum terms.

TL = Tl*[cosd(engl_ang(2))*cosd(engl_ang(3));...
         sind(engl_ang(3));...
         -sind(engl_ang(2))*cosd(engl_ang(3))];
TR = Tr*[cosd(engr_ang(2))*cosd(engr_ang(3));...
         sind(engr_ang(3));...
         -sind(engr_ang(2))*cosd(engr_ang(3))];  
T = TL+TR;

H = hl*[cosd(engl_ang(2))*cosd(engl_ang(3));...
         sind(engl_ang(3));...
         -sind(engl_ang(2))*cosd(engl_ang(3))] + ...
         hr*[cosd(engr_ang(2))*cosd(engr_ang(3));...
         sind(engr_ang(3));...
         -sind(engr_ang(2))*cosd(engr_ang(3))];</P>
        <P Name="fimathString">fimath(...
&apos;RoundMode&apos;, &apos;floor&apos;,...
&apos;OverflowMode&apos;, &apos;wrap&apos;,...
&apos;ProductMode&apos;, &apos;KeepLSB&apos;, &apos;ProductWordLength&apos;, 32,...
&apos;SumMode&apos;, &apos;KeepLSB&apos;, &apos;SumWordLength&apos;, 32,...
&apos;CastBeforeSum&apos;, true)</P>
        <P Name="fimathForFiConstructors">FimathMatlabFactoryDefault</P>
        <P Name="emlDefaultFimath">FimathUserSpecified</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
    <data SSID="4" name="T">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="Tl">
