<?xml version="1.0" encoding="utf-8"?>
<chart id="146">
  <P Name="name">Navigation and Guidance/Heading Control</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">146</P>
  <P Name="ssIdHighWaterMark">9</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="chartFileNumber">14</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">fcn</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">146</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function RollAngle = fcn(FlightState, UHeading, e)

PHeadingAngle = 0.39;

Va = FlightState.AirSpeed;
HeadingAngle = FlightState.HeadingAngle;
FlightPathAngle = FlightState.FlightPathAngle;

YawAngle = HeadingAngle - asin((1/Va)*[e.WindNorth, e.WindEast]*[-sin(HeadingAngle); cos(HeadingAngle)]);
b = [cos(HeadingAngle)*cos(FlightPathAngle), sin(HeadingAngle)*cos(FlightPathAngle), -sin(FlightPathAngle)]*[e.WindNorth; e.WindEast; e.WindDown];
c = [e.WindNorth, e.WindEast, e.WindDown]*[e.WindNorth; e.WindEast; e.WindDown]- Va^2;
Vg = -b+sqrt(b^2-c);

RollAngle = atan2(PHeadingAngle*angdiff(HeadingAngle,UHeading)*Vg,e.Gravity*cos(HeadingAngle-YawAngle));</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
    <data SSID="7" name="FlightState">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_SIMULINK_OBJECT_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="busObject">FixedWingStateBus</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Bus: FixedWingStateBus</P>
    </data>
    <data SSID="4" name="UHeading">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="RollAngle">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">[1 1]</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="e">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_SIMULINK_OBJECT_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="busObject">FixedWingEnvironmentBus</P>
          <P Name="isSigned">1</P>
