      </MaskParameter>
      <MaskParameter Name="bias" Type="edit">
        <Prompt>bias:</Prompt>
        <Value>SensorNoise.pots.Bias</Value>
      </MaskParameter>
      <MaskParameter Name="scf" Type="edit">
