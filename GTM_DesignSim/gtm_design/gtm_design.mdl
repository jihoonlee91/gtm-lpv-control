      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">220</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function RollAngle = fcn(FlightState, UHeading, e)

PHeadingAngle = 0.39;

Va = FlightState.AirSpeed;
HeadingAngle = FlightState.HeadingAngle;
FlightPathAngle = FlightState.FlightPathAngle;

YawAngle = HeadingAngle - asin((1/Va)*[e.WindNorth, e.WindEast]*[-sin(HeadingAngle); cos(HeadingAngle)]);
b = [cos(HeadingAngle)*cos(FlightPathAngle), sin(HeadingAngle)*cos(FlightPathAngle), -sin(FlightPathAngle)]*[e.WindNorth; e.WindEast; e.WindDown];
c = [e.WindNorth, e.WindEast, e.WindDown]*[e.WindNorth; e.WindEast; e.WindDown]- Va^2;
Vg = -b+sqrt(b^2-c);

RollAngle = atan2(PHeadingAngle*angdiff(HeadingAngle,UHeading)*Vg,e.Gravity*cos(HeadingAngle-YawAngle));</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
