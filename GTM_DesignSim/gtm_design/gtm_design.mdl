  <Block BlockType="SubSystem" Name="Implement Damage Models" SID="867">
    <P Name="Ports">[2, 1]</P>
    <P Name="Position">[1140, 509, 1310, 611]</P>
    <P Name="ZOrder">-35</P>
    <P Name="RequestExecContextInheritance">off</P>
    <Mask>
      <Display/>
      <Description>Implements Damage Models as gain and bias effects on selected surfaces.</Description>
      <Initialization>
SurfList={...
    &apos;RUDU&apos;,&apos;RUDL&apos;,...
    &apos;AILL&apos;,&apos;AILR&apos;,...
    &apos;SPLLIB&apos;,&apos;SPLRIB&apos;,&apos;SPLLOB&apos;,&apos;SPLROB&apos;,...
    &apos;STAB&apos;,...
    &apos;ELLOB&apos;,&apos;ELLIB&apos;,&apos;ELRIB&apos;,&apos;ELROB&apos;,...
    &apos;FLAPLOB&apos;,&apos;FALPLIB&apos;,&apos;FLAPRIB&apos;,&apos;FLAPROB&apos;,...
    &apos;GEAR&apos;
    };

Ncases=length(DamageModels);
Nsurfs=length(SurfList);
SurfGain=ones(Ncases,Nsurfs,6);   %Nominally unity gain, zero bias

%If damage case includes gain/bias on a surface adjust nominal values
% First damage case is &quot;no damage&quot;.
for i=1:Ncases,
 for j=1:Nsurfs,
    if isfield(DamageModels{i},SurfList{j}),
        SurfGain(i,j,:)=DamageModels{i}.(SurfList{j}).gain*ones(1,6);
    end
 end
end

        
        </Initialization>
      <MaskParameter Name="DamageModels" Type="edit">
        <Prompt>Cell Array of Damage Models</Prompt>
        <Value>DamageModels</Value>
      </MaskParameter>
    </Mask>
    <System Ref="system_867"/>
  </Block>
