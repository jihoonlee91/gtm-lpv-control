  <Block BlockType="SubSystem" Name="RollYaw Coupling&#xA;LIB" SID="743">
    <P Name="Ports">[1, 1]</P>
    <P Name="Position">[445, 500, 485, 520]</P>
    <P Name="ZOrder">-61</P>
    <P Name="BackgroundColor">cyan</P>
    <P Name="RequestExecContextInheritance">off</P>
    <Mask>
      <Display/>
      <Description>Approximates roll/yaw coupling of split longitudinal surface 
deflections (spoilers, elevators, flaps) where the base aero data only
has CX, CZ, and Cm. Input should be a 6 element vector of the aero
coefficients [CZ CY CZ Cl Cm Cn].

Cl = Cl_input + arm*CZ_input
Cn = Cn_input + arm*CX_input</Description>
      <Initialization>Kc = eye(6);

Kc(4,3) = arm; % Cl = Cl + arm*CZ
Kc(6,1) = -arm; % Cn = Cn - arm*CX</Initialization>
      <MaskParameter Name="arm" Type="edit">
        <Prompt>Moment arm (nd)</Prompt>
        <Value>-0.03</Value>
      </MaskParameter>
    </Mask>
    <System Ref="system_743"/>
  </Block>
