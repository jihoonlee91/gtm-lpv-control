  <Block BlockType="SubSystem" Name="NamedStore" SID="53">
    <P Name="Ports">[1]</P>
    <P Name="Position">[825, 421, 875, 449]</P>
    <P Name="ZOrder">1165</P>
    <P Name="BackgroundColor">cyan</P>
    <P Name="StopFcn">% if strmatch(get_param(gcb,&apos;do_stopfcn_callback&apos;),...
% &apos;on&apos;,&apos;exact&apos;)                                       
%    if exist(&apos;logsout&apos;,&apos;var&apos;)                        
%        sout = CreateSimOut(logsout);                
%    else                                             
%         %disp(&apos;No Log Data Variable&apos;)               
%     end                                             
% clear logsout                                       
% end                                                 </P>
    <P Name="FontName">helvetica</P>
    <P Name="FontSize">12</P>
    <P Name="RequestExecContextInheritance">off</P>
    <Mask>
      <Display/>
      <Description>Produces signal log of input data.  If post processing is selected the logsout object is converted into a data structure (sout) with fields named after the bus signals.  In this case a common time base is recommended.</Description>
      <Initialization>H=get_param([gcb,&apos;/In&apos;],&apos;PortHandles&apos;);
if (enable_logging)
    set(H.Outport(1),&apos;DataLogging&apos;,&apos;on&apos;)
else
    set(H.Outport(1),&apos;DataLogging&apos;,&apos;off&apos;)
    
end
</Initialization>
      <MaskParameter Name="enable_logging" Type="checkbox">
        <Prompt>Enable Data Logging</Prompt>
        <Value>on</Value>
      </MaskParameter>
      <MaskParameter Name="do_stopfcn_callback" Type="checkbox">
