    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">53</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function[omega,pqr_osc]= hykal(alpha,beta,tas,pqr,B,Cbar)
% Hybrid Kalviste blending method for use in embedded block in Simulink.
%
% Austin Murch
% Austin.M.Murch@nasa.gov

% Dimension vector outputs.
pqr_osc=zeros(3,1);
 

% Constants
dtr=pi/180;
knots2ft=1.689;

% Setup variables
pb=pqr(1);
qb=pqr(2);
rb=pqr(3);

alpha = alpha*dtr;
beta = beta*dtr;
omega = 0;

%----Hybrid Kalviste Method----%
whichcase = 0;

%Test for case 1: p_osc = 0
if cos(alpha)*cos(beta) == 0
elseif pb == 0
else
    omega = pb/(cos(alpha)*cos(beta));
    r_osc = rb - omega*sin(alpha)*cos(beta);
    if abs(r_osc) &gt; abs(rb)
    elseif r_osc*rb &lt; 0
    else
        whichcase = 1;
    end
end

%Test for case 2: r_osc = 0
if sin(alpha)*cos(beta) == 0
elseif rb == 0
else
    omega = rb/(sin(alpha)*cos(beta));
    p_osc = pb - omega*cos(alpha)*cos(beta);
    if abs(p_osc) &gt; abs(pb)
    elseif p_osc*pb &lt; 0
    else
        whichcase = 2;
    end
end

%Test for case 3: Omega = 0
if whichcase == 0
    whichcase = 3;
end

 

switch whichcase
    case 1
        omega = pb/(cos(alpha)*cos(beta));
        pqr_osc(1) = 0;        
        pqr_osc(2) = qb - omega*sin(beta);        
        pqr_osc(3) = rb - omega*sin(alpha)*cos(beta);

    case 2
        omega = rb/(sin(alpha)*cos(beta));
        pqr_osc(1) = pb - omega*cos(alpha)*cos(beta);
        pqr_osc(2) = qb - omega*sin(beta);
        pqr_osc(3) = 0;

    case 3
        pqr_osc(1) = pb;
        pqr_osc(2) = qb;
        pqr_osc(3) = rb;
        omega = 0;
end

%-----------------------------------------------% End Hybrid Kalviste

% Scale values for table lookup
b2vt=B/(2*tas*knots2ft);
c2vt=Cbar/(2*tas*knots2ft);
omega=omega*b2vt;
pqr_osc=pqr_osc.*[b2vt;c2vt;b2vt];

 </P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[305.0, 535.0, 671.0, 364.0]</P>
        <P Name="fimathString">fimath(...
&apos;RoundMode&apos;, &apos;floor&apos;,...
&apos;OverflowMode&apos;, &apos;wrap&apos;,...
&apos;ProductMode&apos;, &apos;KeepLSB&apos;, &apos;ProductWordLength&apos;, 32,...
&apos;SumMode&apos;, &apos;KeepLSB&apos;, &apos;SumWordLength&apos;, 32,...
&apos;CastBeforeSum&apos;, true)</P>
        <P Name="emlDefaultFimath">FimathUserSpecified</P>
        <P Name="vectorOutputs1D">1</P>
      </eml>
    </state>
    <data SSID="4" name="alpha">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="omega">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="beta">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="tas">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="8" name="pqr">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="9" name="pqr_osc">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="10" name="B">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="11" name="Cbar">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
