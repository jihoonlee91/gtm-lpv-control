        <Value>LandingGear.DampingConst</Value>
      </MaskParameter>
      <MaskParameter Name="StrokeLength" Type="edit">
        <Prompt>Stroke Length [Nose,Left,Right]</Prompt>
        <Value>LandingGear.StrokeLength</Value>
      </MaskParameter>
      <MaskParameter Name="MountStiffness" Type="edit">
